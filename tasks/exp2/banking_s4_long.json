8\u0949\u092e\u093f\u0928\u0940 \u092c\u0928\u093e\u0913\u0964\n\u092e\u0948\u0902\u0928\u0947 Meera Iyer \u0915\u094b \u20b925,000 \u0915\u093e \u091c\u094b \u091a\u0947\u0915 \u0926\u093f\u092f\u093e \u0925\u093e, \u0909\u0938\u0947 \u0930\u094b\u0915 \u0926\u094b; \u0935\u0939 \u092a\u0947\u092e\u0947\u0902\u091f \u0930\u0926\u094d\u0926 \u0939\u094b \u0917\u092f\u093e \u0939\u0948\u0964\n\u0915\u0928\u094d\u092b\u093c\u0930\u094d\u092e\u0947\u0936\u0928 \u0938\u093f\u0930\u094d\u092b\u093c SMS \u0938\u0947 \u092d\u0947\u091c\u0928\u093e \u0914\u0930 \u0938\u093e\u0930\u0940 \u0930\u093f\u0915\u094d\u0935\u0947\u0938\u094d\u091f \u092e\u0947\u0930\u0940 \u0939\u094b\u092e \u092c\u094d\u0930\u093e\u0902\u091a Andheri West \u0938\u0947 \u091c\u094b\u0921\u093c\u0928\u093e\u0964",
  "ta": "\u0b8e\u0ba9\u0bcd \u0ba8\u0bc6\u0b9f\u0bcd \u0baa\u0bc7\u0b99\u0bcd\u0b95\u0bbf\u0b99\u0bcd\u0b95\u0bbf\u0bb2\u0bcd \u0b9a\u0bbf\u0bb2 \u0bb5\u0bc7\u0bb2\u0bc8\u0b95\u0bb3\u0bc8\u0b9a\u0bcd \u0b9a\u0bc6\u0baf\u0bcd\u0baf\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd; \u0b8e\u0bb2\u0bcd\u0bb2\u0bbe\u0bb5\u0bb1\u0bcd\u0bb1\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0bb5\u0bb0\u0bbf\u0b9a\u0bc8\u0baf\u0bbf\u0bb2\u0bcd \u0bb5\u0bc8\u0ba4\u0bcd\u0ba4\u0bc1 \u0b95\u0b9f\u0bc8\u0b9a\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0b92\u0ba9\u0bcd\u0bb1\u0bbe\u0b95 \u0b9a\u0baa\u0bcd\u0bae\u0bbf\u0b9f\u0bcd \u0b9a\u0bc6\u0baf\u0bcd\u0baf\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd.\n\u0b85\u0b95\u0bcd\u0b9f\u0bcb\u0baa\u0bb0\u0bcd 22 \u0b85\u0ba9\u0bcd\u0bb1\u0bc1 Zomato \u0b8e\u0ba9\u0bcd \u0b9a\u0bc7\u0bae\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bcd \u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bbf\u0bb2\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 \u20b9799 \u0b87\u0bb0\u0ba3\u0bcd\u0b9f\u0bc1 \u0bae\u0bc1\u0bb1\u0bc8 \u0b8e\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0bbf\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1. \u0b87\u0bb0\u0ba3\u0bcd\u0b9f\u0bbe\u0bb5\u0ba4\u0bc1, \u0b9f\u0bc2\u0baa\u0bcd\u0bb3\u0bbf\u0b95\u0bc7\u0b9f\u0bcd \u0b9a\u0bbe\u0bb0\u0bcd\u0b9c\u0bcd \u0bae\u0bc0\u0ba4\u0bc1 \u0b9f\u0bbf\u0bb8\u0bcd\u0baa\u0bcd\u0baf\u0bc2\u0b9f\u0bcd \u0baa\u0ba4\u0bbf\u0bb5\u0bc1 \u0b9a\u0bc6\u0baf\u0bcd\u0baf\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd.\n\u0b95\u0b9f\u0bc8\u0b9a\u0bbf \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0b99\u0bcd\u0b95\u0bb3\u0bcd 6091 \u0b89\u0bb3\u0bcd\u0bb3 \u0b8e\u0ba9\u0bcd \u0b9a\u0bc7\u0bae\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bcd \u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bc1 \u0b9f\u0bc6\u0baa\u0bbf\u0b9f\u0bcd \u0b95\u0bbe\u0bb0\u0bcd\u0b9f\u0bc1 \u0ba4\u0bbf\u0bb0\u0bc1\u0b9f\u0bc1\u0baa\u0bcb\u0baf\u0bcd\u0bb5\u0bbf\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1. \u0b85\u0ba4\u0bc8 \u0baa\u0bbf\u0bb3\u0bbe\u0b95\u0bcd \u0b9a\u0bc6\u0baf\u0bcd\u0baf\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd.\n\u0b85\u0ba8\u0bcd\u0ba4 \u0b95\u0bbe\u0bb0\u0bcd\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1 \u0b95\u0bbe\u0bb0\u0bcd\u0b9f\u0bc1 \u0b86\u0bb0\u0bcd\u0b9f\u0bb0\u0bcd \u0b9a\u0bc6\u0baf\u0bcd\u0ba4\u0bc1, \u0b8e\u0ba9\u0bcd \u0bb5\u0bc0\u0b9f\u0bcd\u0b9f\u0bc1 \u0bae\u0bc1\u0b95\u0bb5\u0bb0\u0bbf\u0b95\u0bcd\u0b95\u0bc1 \u0b9f\u0bc6\u0bb2\u0bbf\u0bb5\u0bb0\u0bbf \u0b9a\u0bc6\u0baf\u0bcd\u0baf\u0b9a\u0bcd \u0b9a\u0bca\u0bb2\u0bcd\u0bb2\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd.\n\u0b8e\u0ba9\u0bcd \u0b9a\u0bae\u0bcd\u0baa\u0bb3\u0b95\u0bcd \u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bc1 \u0b9f\u0bc6\u0baa\u0bbf\u0b9f\u0bcd \u0b95\u0bbe\u0bb0\u0bcd\u0b9f\u0bbf\u0bb2\u0bcd \u0b87\u0ba9\u0bcd\u0b9f\u0bb0\u0bcd\u0ba8\u0bc7\u0bb7\u0ba9\u0bb2\u0bcd \u0b86\u0ba9\u0bcd\u0bb2\u0bc8\u0ba9\u0bcd \u0bb2\u0bbf\u0bae\u0bbf\u0b9f\u0bcd\u0b9f\u0bc8 \u0b92\u0bb0\u0bc1 \u0ba8\u0bbe\u0bb3\u0bc8\u0b95\u0bcd\u0b95\u0bc1 \u20b950,000 \u0b86\u0b95 \u0bb5\u0bc8\u0baf\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd.\n\u0b8e\u0ba9\u0bcd \u0b9a\u0bc7\u0bae\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bcd \u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bbf\u0bb2\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 \u20b9150,000-\u0b95\u0bcd\u0b95\u0bc1 \u0b92\u0bb0\u0bc1 \u0b83\u0baa\u0bbf\u0b95\u0bcd\u0bb8\u0b9f\u0bcd \u0b9f\u0bc6\u0baa\u0bbe\u0b9a\u0bbf\u0b9f\u0bcd \u0ba4\u0bca\u0b9f\u0b99\u0bcd\u0b95\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd: \u0b95\u0bbe\u0bb2\u0bae\u0bcd 12 \u0bae\u0bc1\u0ba4\u0bb2\u0bcd 30 \u0bae\u0bbe\u0ba4\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bb3\u0bcd, \u0bae\u0bc1\u0ba9\u0bcd\u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0bbf\u0baf\u0bc7 \u0b8e\u0b9f\u0bc1\u0b95\u0bcd\u0b95 \u0b85\u0ba9\u0bc1\u0bae\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0bb5\u0b9f\u0bcd\u0b9f\u0bbf \u0bb5\u0bbf\u0b95\u0bbf\u0ba4\u0bae\u0bcd \u0b85\u0ba4\u0bbf\u0b95\u0bae\u0bbe\u0ba9\u0ba4\u0bc1; \u0bb5\u0b9f\u0bcd\u0b9f\u0bbf \u0bae\u0bbe\u0ba4\u0bbe\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0 \u0bae\u0bc1\u0bb1\u0bc8\u0baf\u0bbf\u0bb2\u0bcd \u0bb5\u0bb0 \u0bb5\u0bc7\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd.\n\u0b8e\u0ba9\u0bcd \u0b9a\u0bae\u0bcd\u0baa\u0bb3\u0b95\u0bcd \u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bbf\u0bb2\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 \u0bae\u0bbe\u0ba4\u0bae\u0bcd \u20b97,500 \u0bb0\u0bc6\u0b95\u0bcd\u0b95\u0bb0\u0bbf\u0b99\u0bcd \u0b9f\u0bc6\u0baa\u0bbe\u0b9a\u0bbf\u0b9f\u0bcd \u0b92\u0ba9\u0bcd\u0bb1\u0bc8\u0ba4\u0bcd \u0ba4\u0bca\u0b9f\u0b99\u0bcd\u0b95\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd; \u0b85\u0ba4\u0bc1 \u0b85\u0ba8\u0bcd\u0ba4 \u0b83\u0baa\u0bbf\u0b95\u0bcd\u0bb8\u0b9f\u0bcd \u0b9f\u0bc6\u0baa\u0bbe\u0b9a\u0bbf\u0b9f\u0bcd \u0bae\u0bc1\u0ba4\u0bbf\u0bb0\u0bcd\u0bb5\u0b9f\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0b85\u0ba4\u0bc7 \u0bae\u0bbe\u0ba4\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0bae\u0bc1\u0ba4\u0bbf\u0bb0\u0bcd\u0bb5\u0b9f\u0bc8\u0baf \u0bb5\u0bc7\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd.\n\u0baa\u0bc1\u0ba4\u0bbf\u0baf \u0b83\u0baa\u0bbf\u0b95\u0bcd\u0bb8\u0b9f\u0bcd \u0b9f\u0bc6\u0baa\u0bbe\u0b9a\u0bbf\u0b9f\u0bcd\u0b9f\u0bbf\u0bb2\u0bcd \u0b85\u0bae\u0bcd\u0bae\u0bbe\u0bb5\u0bc8 100% \u0baa\u0b99\u0bcd\u0b95\u0bc1\u0b9f\u0ba9\u0bcd \u0ba8\u0bbe\u0bae\u0bbf\u0ba9\u0bbf\u0baf\u0bbe\u0b95\u0b9a\u0bcd \u0b9a\u0bc7\u0bb0\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd.\nMeera Iyer-\u0b95\u0bcd\u0b95\u0bc1 \u0ba8\u0bbe\u0ba9\u0bcd \u0b95\u0bca\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4 \u20b925,000 \u0b95\u0bbe\u0b9a\u0bcb\u0bb2\u0bc8\u0baf\u0bc8 \u0ba8\u0bbf\u0bb1\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd; \u0b85\u0ba8\u0bcd\u0ba4\u0baa\u0bcd \u0baa\u0ba3\u0bae\u0bcd \u0b9a\u0bc6\u0bb2\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0ba4\u0bb2\u0bcd \u0bb0\u0ba4\u0bcd\u0ba4\u0bbe\u0b95\u0bbf\u0bb5\u0bbf\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1.\n\u0b89\u0bb1\u0bc1\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd\u0b95\u0bb3\u0bc8 SMS \u0bae\u0bc2\u0bb2\u0bae\u0bcd \u0bae\u0b9f\u0bcd\u0b9f\u0bc1\u0bae\u0bcd \u0b85\u0ba9\u0bc1\u0baa\u0bcd\u0baa\u0bbf, \u0b8e\u0bb2\u0bcd\u0bb2\u0bbe \u0b95\u0bcb\u0bb0\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0b95\u0bb3\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0b8e\u0ba9\u0bcd \u0bb9\u0bcb\u0bae\u0bcd \u0baa\u0bbf\u0bb0\u0bbe\u0b9e\u0bcd\u0b9a\u0bcd Andheri West-\u0b89\u0b9f\u0ba9\u0bcd \u0b87\u0ba3\u0bc8\u0baf\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd.",
  "hinglish": "Meri net banking pe kuch kaam kar do, sab queue mein daalo aur end mein ek saath submit karo.\n22 October ko Zomato ne mere savings account se \u20b9799 do baar kaat liye. Doosre, duplicate charge pe dispute raise karo.\nMera savings account wala debit card jiske last digits 6091 hain, chori ho gaya hai. Use block kar do.\nUs card ka replacement mangwao, mere ghar wale address pe.\nMere salary account wale debit card pe international online limit \u20b950,000 per day kar do.\nMere savings account se \u20b9150,000 ka fixed deposit kholo, us scheme mein jiska tenure 12 se 30 months ke beech ho, premature withdrawal allowed ho, aur unme jiska interest rate sabse zyada ho; interest payout monthly ho.\nMere salary account se \u20b97,500 mahine ka ek recurring deposit start karo jo usi mahine mature ho jis mahine wo fixed deposit.\nNaye fixed deposit pe Mummy ko 100% share ke saath nominee banao.\nMaine Meera Iyer ko \u20b925,000 ka jo cheque diya tha, use stop kar do; wo payment cancel ho gaya hai.\nConfirmations sirf SMS pe bhejna aur saari requests meri home branch Andheri West se attach karna.",
  "tanglish": "En net banking-la konjam velai pannunga, ellathayum queue-la vechu kadaisila onna submit pannunga.\nOctober 22 anniki Zomato en savings account-la \u20b9799 rendu thadava eduthuttanga. Rendavadhu, duplicate charge mela dispute raise pannunga.\nLast digits 6091 irukkara en savings account debit card thirudu poyiduchu. Adha block pannunga.\nAndha card-ku replacement order panni, en veettu address-ku deliver panna sollunga.\nEn salary account debit card-la international online limit-a oru naalukku \u20b950,000-a vainga.\nEn savings account-la irundhu \u20b9150,000-ku oru fixed deposit open pannunga: tenure 12 la irundhu 30 months-kulla, premature withdrawal allow pannra schemes-la interest rate adhigama irukkaradhu; interest payout monthly-a irukkanum.\nEn salary account-la irundhu maasam \u20b97,500 recurring deposit onnu start pannunga, adhu andha fixed deposit mature aagura adhe maasam mature aaganum.\nPudhu fixed deposit-la Amma-va 100% share-oda nominee-a add pannunga.\nMeera Iyer-ku naan kudutha \u20b925,000 cheque-a stop pannunga; andha payment cancel aayiduchu.\nConfirmations-a SMS-la mattum anuppunga, ella requests-ayum en home branch Andheri West-oda attach pannunga."
 },
